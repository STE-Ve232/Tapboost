// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  firstName       String?
  lastName        String?
  phone           String?   @unique
  isEmailVerified Boolean   @default(false)
  isPhoneVerified Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  wallet          Wallet?
  sessions        LoginSession[]
  kycRequest      KYCRequest?
  linkedCards     LinkedCard[]
}

model Wallet {
  id               String       @id @default(cuid())
  balance          Decimal      @default(0.0) @db.Decimal(12, 2)
  pendingEarnings  Decimal      @default(0.0) @db.Decimal(12, 2)
  lifetimeEarnings Decimal      @default(0.0) @db.Decimal(12, 2)
  totalWithdrawn   Decimal      @default(0.0) @db.Decimal(12, 2)
  currency         String       @default("USD")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User         @relation(fields: [userId], references: [id])
  userId           String       @unique
  transactions     Transaction[]
  deposits         Deposit[]
  withdrawals      Withdrawal[]
}

model Transaction {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(12, 2)
  type        String // e.g., DEPOSIT, WITHDRAWAL, REWARD
  status      String // e.g., PENDING, COMPLETED, FAILED
  reference   String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  wallet      Wallet   @relation(fields: [walletId], references: [id])
  walletId    String
}

model LinkedCard {
  id              String   @id @default(cuid())
  providerToken   String   @unique
  last4           String
  brand           String // e.g., Visa, Mastercard
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])
  userId          String
}

model Withdrawal {
  id                String   @id @default(cuid())
  amount            Decimal  @db.Decimal(12, 2)
  status            String   @default("PENDING")
  method            String   // e.g., MPESA, BANK, CRYPTO
  destination       String
  processingTimeEst String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  wallet            Wallet   @relation(fields: [walletId], references: [id])
  walletId          String
}

model Deposit {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(12, 2)
  status    String   @default("PENDING")
  method    String   // e.g., MPESA, CARD, BANK
  reference String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  wallet    Wallet   @relation(fields: [walletId], references: [id])
  walletId  String
}

model KYCRequest {
  id              String   @id @default(cuid())
  status          String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  documentType    String?  // e.g., ID, PASSPORT
  documentFront   String?
  documentBack    String?
  selfie          String?
  address         String?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
  userId          String   @unique
}

model LoginSession {
  id        String   @id @default(cuid())
  token     String   @unique
  ipAddress String
  userAgent String
  isValid   Boolean  @default(true)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
}
